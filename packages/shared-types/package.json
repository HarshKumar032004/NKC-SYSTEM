{
  "name": "@nkc/shared-types",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@nkc/eslint-config": "workspace:*",
    "@nkc/tsconfig": "workspace:*",
    "eslint": "^9.17.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "zod": "^4.5.4"
  }
}
