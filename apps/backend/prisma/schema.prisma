// ─────────────────────────────────────────────────────────────────────────────
// NKC Institute Management System — Prisma Schema
// Database: PostgreSQL 16
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum StudentStatus {
  ENROLLED
  SUSPENDED
  ALUMNI
  WITHDRAWN
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  COMPLETED
  TRANSFERRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum FeeStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  EXPORT
}

enum LeadStatus {
  NEW
  CONTACTED
  DEMO_SCHEDULED
  COUNSELED
  ADMISSION_PENDING
  CONVERTED
  LOST
}

enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  UPI
  CHEQUE
  ONLINE
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
}

enum PaymentType {
  LUMP_SUM
  INSTALLMENT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ExamStatus {
  SCHEDULED
  MARKING
  PUBLISHED
}

enum NotificationRecipientType {
  STUDENT
  GUARDIAN
  STAFF
}

enum NotificationChannel {
  IN_APP
  WHATSAPP
  SMS
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum PayrollStatus {
  PENDING
  PROCESSED
  PAID
}

enum InventoryCategory {
  BOOK
  UNIFORM
  MERCH
}

enum StockTransactionType {
  IN
  OUT
}

enum ExpenseCategory {
  ELECTRONICS
  FURNITURE
  MAINTENANCE
  STATIONERY
  UTILITIES
  OTHER
}

enum ExpenseStatus {
  PENDING
  RESOLVED
}

// ─── Branch ───────────────────────────────────────────────────────────────────
// Top-level multi-tenant isolation unit. Every domain entity links back here.

model Branch {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(150)
  code         String   @unique @db.VarChar(20)
  address      String   @db.Text
  contactPhone String   @map("contact_phone") @db.VarChar(20)
  email        String?  @db.VarChar(255)
  city         String?  @db.VarChar(100)
  state        String?  @db.VarChar(100)
  zipCode      String?  @map("zip_code") @db.VarChar(20)
  managerName  String?  @map("manager_name") @db.VarChar(150)
  hostelFee    Decimal  @default(0) @map("hostel_fee") @db.Decimal(10, 2)
  messFee      Decimal  @default(0) @map("mess_fee") @db.Decimal(10, 2)
  settings     Json     @default("{}")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users                 User[]
  students              Student[]
  courses               Course[]
  batches               Batch[]
  leads                 Lead[]
  feeStructures         FeeStructure[]
  paymentTransactions   PaymentTransaction[]
  rooms                 Room[]
  timetableSessions     TimetableSession[]
  attendanceRecords     AttendanceRecord[]
  exams                 Exam[]
  gradeScales           GradeScale[]
  notifications         Notification[]
  notificationTemplates NotificationTemplate[]
  subjects              Subject[]
  teacherProfiles       TeacherProfile[]
  payrollRecords        PayrollRecord[]
  inventoryItems        InventoryItem[]
  stockTransactions     StockTransaction[]
  materialIssues        MaterialIssue[]
  maintenanceExpenses   MaintenanceExpense[]

  @@map("branches")
}

// ─── Role & Permission (RBAC) ─────────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system") // system roles cannot be deleted
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  resource    String   @db.VarChar(100) // e.g. "students", "fees"
  action      String   @db.VarChar(50) // e.g. "create", "read", "update", "delete"
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.Text
  roleId       String    @map("role_id") @db.Uuid
  branchId     String    @map("branch_id") @db.Uuid
  isActive          Boolean   @default(true) @map("is_active")
  mfaSecret         String?   @map("mfa_secret") @db.Text
  mfaPendingSecret  String?   @map("mfa_pending_secret") @db.Text
  resetTokenHash    String?   @map("reset_token_hash") @db.Text
  resetTokenExpires DateTime? @map("reset_token_expires") @db.Timestamptz
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  role   Role   @relation(fields: [roleId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  auditLogs         AuditLog[]
  notices           Notice[]
  assignedLeads     Lead[]             @relation("LeadCounselor")
  leadFollowUps     LeadFollowUp[]
  teacherProfile    TeacherProfile?
  issuedMaterials   MaterialIssue[]    @relation("Issuer")

  @@index([branchId, createdAt])
  @@index([branchId, isActive])
  @@map("users")
}

// ─── Student ──────────────────────────────────────────────────────────────────

model Student {
  id               String        @id @default(uuid()) @db.Uuid
  enrollmentNumber String        @unique @map("enrollment_number") @db.VarChar(30)
  firstName        String        @map("first_name") @db.VarChar(100)
  lastName         String        @map("last_name") @db.VarChar(100)
  dob              DateTime      @db.Date
  gender           Gender
  bloodGroup       BloodGroup?   @map("blood_group")
  branchId         String        @map("branch_id") @db.Uuid
  status           StudentStatus @default(ENROLLED)
  photoUrl         String?       @map("photo_url") @db.Text
  address          String?       @db.Text
  email            String?       @db.VarChar(255)
  phone            String?       @db.VarChar(20)
  aadharNumber     String?       @unique @map("aadhar_number") @db.VarChar(20)
  admissionDate    DateTime      @default(now()) @map("admission_date") @db.Date
  previousSchool   String?       @map("previous_school") @db.VarChar(255)
  isHosteler       Boolean       @default(false) @map("is_hosteler")
  discountPercent  Decimal       @default(0) @map("discount_percent") @db.Decimal(5, 2)
  paymentType      PaymentType   @default(LUMP_SUM) @map("payment_type")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz // soft delete

  branch              Branch               @relation(fields: [branchId], references: [id])
  guardians           Guardian[]
  enrollments         Enrollment[]
  feeInvoices         FeeInvoice[]
  documents           Document[]
  feeInstallments     FeeInstallment[]
  paymentTransactions PaymentTransaction[]
  attendanceRecords   AttendanceRecord[]
  examResults         ExamResult[]
  materialIssues      MaterialIssue[]

  @@index([branchId, createdAt])
  @@index([branchId, status])
  @@map("students")
}

// ─── Document ─────────────────────────────────────────────────────────────────

model Document {
  id         String   @id @default(uuid()) @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  fileName   String   @map("file_name") @db.VarChar(255)
  fileKey    String   @unique @map("file_key") @db.VarChar(255) // S3 object key
  mimeType   String   @map("mime_type") @db.VarChar(100)
  sizeBytes  Int      @map("size_bytes")
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("documents")
}

// ─── Guardian ─────────────────────────────────────────────────────────────────

model Guardian {
  id           String   @id @default(uuid()) @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  name         String   @db.VarChar(150)
  relationship String   @db.VarChar(50)
  phone        String   @db.VarChar(20)
  email        String?  @db.VarChar(255)
  occupation   String?  @db.VarChar(100)
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("guardians")
}

// ─── Course ───────────────────────────────────────────────────────────────────

model Course {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  code        String   @db.VarChar(20)
  name        String   @db.VarChar(150)
  credits     Int      @default(0)
  semester    Int
  description String?  @db.Text
  baseFee     Decimal  @default(0) @map("base_fee") @db.Decimal(10, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  branch  Branch  @relation(fields: [branchId], references: [id])
  batches Batch[]

  @@unique([branchId, code])
  @@index([branchId, createdAt])
  @@map("courses")
}

// ─── Batch ────────────────────────────────────────────────────────────────────

model Batch {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  name      String   @db.VarChar(100)
  capacity  Int      @default(60)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  course            Course             @relation(fields: [courseId], references: [id])
  branch            Branch             @relation(fields: [branchId], references: [id])
  enrollments       Enrollment[]
  timetableSessions TimetableSession[]
  attendanceRecords AttendanceRecord[]
  exams             Exam[]

  @@index([branchId, createdAt])
  @@index([branchId, isActive])
  @@map("batches")
}

// ─── Enrollment ───────────────────────────────────────────────────────────────

model Enrollment {
  id         String           @id @default(uuid()) @db.Uuid
  studentId  String           @map("student_id") @db.Uuid
  batchId    String           @map("batch_id") @db.Uuid
  enrolledAt DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz
  status     EnrollmentStatus @default(ACTIVE)
  deletedAt  DateTime?        @map("deleted_at") @db.Timestamptz // soft delete

  student Student @relation(fields: [studentId], references: [id])
  batch   Batch   @relation(fields: [batchId], references: [id])

  @@unique([studentId, batchId])
  @@index([batchId, status])
  @@map("enrollments")
}

// ─── AttendanceRecord ───────────────────────────────────────────────────────────

model AttendanceRecord {
  id        String           @id @default(uuid()) @db.Uuid
  studentId String           @map("student_id") @db.Uuid
  batchId   String           @map("batch_id") @db.Uuid
  branchId  String           @map("branch_id") @db.Uuid
  date      DateTime         @db.Date
  status    AttendanceStatus
  remarks   String?          @db.Text
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  student Student @relation(fields: [studentId], references: [id])
  batch   Batch   @relation(fields: [batchId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@unique([studentId, date, batchId])
  @@index([batchId, date])
  @@index([branchId, date])
  @@map("attendance_records")
}

// ─── Phase 10: Exams, Grading & Report Card Generation ────────────────────────

model Exam {
  id            String     @id @default(uuid()) @db.Uuid
  name          String     @db.VarChar(150)
  batchId       String     @map("batch_id") @db.Uuid
  branchId      String     @map("branch_id") @db.Uuid
  examDate      DateTime   @map("exam_date") @db.Date
  totalMarks    Int        @map("total_marks") // sum of all subject maxMarks
  invigilatorId String?    @map("invigilator_id") @db.Uuid
  status        ExamStatus @default(SCHEDULED)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  batch       Batch           @relation(fields: [batchId], references: [id])
  branch      Branch          @relation(fields: [branchId], references: [id])
  invigilator TeacherProfile? @relation("ExamInvigilator", fields: [invigilatorId], references: [id])
  subjects    ExamSubject[]
  results     ExamResult[]

  @@index([batchId, status])
  @@index([branchId, examDate])
  @@map("exams")
}

model ExamSubject {
  id           String @id @default(uuid()) @db.Uuid
  examId       String @map("exam_id") @db.Uuid
  name         String @db.VarChar(100)
  maxMarks     Int    @map("max_marks")
  passingMarks Int    @map("passing_marks")

  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  results ExamResult[]

  @@index([examId])
  @@map("exam_subjects")
}

model ExamResult {
  id            String   @id @default(uuid()) @db.Uuid
  examId        String   @map("exam_id") @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  subjectId     String   @map("subject_id") @db.Uuid
  marksObtained Int      @map("marks_obtained")
  remarks       String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  exam    Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject ExamSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId])
  @@index([examId, studentId])
  @@map("exam_results")
}

model GradeScale {
  id            String  @id @default(uuid()) @db.Uuid
  branchId      String  @map("branch_id") @db.Uuid
  minPercentage Float   @map("min_percentage") // 0.0 to 100.0
  maxPercentage Float   @map("max_percentage") // 0.0 to 100.0
  grade         String  @db.VarChar(5) // e.g., A+, A, B
  remarks       String? @db.VarChar(50)

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@map("grade_scales")
}

// ─── Fee Invoice ──────────────────────────────────────────────────────────────

model FeeInvoice {
  id          String    @id @default(uuid()) @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  invoiceNo   String    @unique @map("invoice_no") @db.VarChar(50)
  amount      Decimal   @db.Decimal(10, 2)
  status      FeeStatus @default(PENDING)
  dueDate     DateTime  @map("due_date") @db.Date
  paidDate    DateTime? @map("paid_date") @db.Date
  paymentRef  String?   @map("payment_ref") @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz // soft delete

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt])
  @@index([studentId, status])
  @@map("fee_invoices")
}

// ─── Notice ───────────────────────────────────────────────────────────────────

model Notice {
  id          String    @id @default(uuid()) @db.Uuid
  createdById String    @map("created_by_id") @db.Uuid
  title       String    @db.VarChar(200)
  body        String    @db.Text
  audience    String    @default("ALL") @db.VarChar(20) // ALL | STUDENTS | FACULTY | STAFF
  publishedAt DateTime  @default(now()) @map("published_at") @db.Timestamptz
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([publishedAt])
  @@map("notices")
}

// ─── Audit Log (append-only) ──────────────────────────────────────────────────

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  action    AuditAction
  entity    String      @db.VarChar(100) // table/model name
  entityId  String      @map("entity_id") @db.VarChar(100)
  oldData   Json?       @map("old_data")
  newData   Json?       @map("new_data")
  ipAddress String?     @map("ip_address") @db.VarChar(45) // supports IPv6
  userAgent String?     @map("user_agent") @db.Text
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // NOTE: No updatedAt — audit logs are strictly append-only
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Lead ─────────────────────────────────────────────────────────────────────

model Lead {
  id                  String     @id @default(uuid()) @db.Uuid
  branchId            String     @map("branch_id") @db.Uuid
  name                String     @db.VarChar(150)
  phone               String     @db.VarChar(20)
  email               String?    @db.VarChar(255)
  source              String?    @db.VarChar(50)
  status              LeadStatus @default(NEW)
  assignedCounselorId String?    @map("assigned_counselor_id") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  branch            Branch         @relation(fields: [branchId], references: [id])
  assignedCounselor User?          @relation("LeadCounselor", fields: [assignedCounselorId], references: [id])
  followUps         LeadFollowUp[]

  @@index([branchId, status])
  @@index([assignedCounselorId])
  @@map("leads")
}

// ─── LeadFollowUp ─────────────────────────────────────────────────────────────

model LeadFollowUp {
  id               String    @id @default(uuid()) @db.Uuid
  leadId           String    @map("lead_id") @db.Uuid
  performedById    String    @map("performed_by_id") @db.Uuid
  notes            String    @db.Text
  contactMethod    String    @map("contact_method") @db.VarChar(50) // e.g. "PHONE", "EMAIL", "IN_PERSON"
  outcome          String?   @db.VarChar(100)
  nextFollowUpDate DateTime? @map("next_follow_up_date") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  lead        Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  performedBy User @relation(fields: [performedById], references: [id])

  @@index([leadId, createdAt])
  @@index([performedById])
  @@map("lead_follow_ups")
}

// ─── Phase 7: Fee Engine ──────────────────────────────────────────────────────

model FeeStructure {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  totalAmount Int      @map("total_amount") // stored in cents/paise
  branchId    String   @map("branch_id") @db.Uuid
  isArchived  Boolean  @default(false) @map("is_archived")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  branch       Branch           @relation(fields: [branchId], references: [id])
  installments FeeInstallment[]

  @@index([branchId, isArchived])
  @@map("fee_structures")
}

model FeeInstallment {
  id             String            @id @default(uuid()) @db.Uuid
  studentId      String            @map("student_id") @db.Uuid
  feeStructureId String            @map("fee_structure_id") @db.Uuid
  dueDate        DateTime          @map("due_date") @db.Date
  amountDue      Int               @map("amount_due") // cents
  amountPaid     Int               @default(0) @map("amount_paid") // cents
  status         InstallmentStatus @default(PENDING)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  student      Student      @relation(fields: [studentId], references: [id])
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])

  @@index([studentId, status])
  @@map("fee_installments")
}

model PaymentTransaction {
  id              String        @id @default(uuid()) @db.Uuid
  studentId       String        @map("student_id") @db.Uuid
  branchId        String        @map("branch_id") @db.Uuid
  amount          Int // cents
  paymentMethod   PaymentMethod @map("payment_method")
  referenceNumber String?       @map("reference_number") @db.VarChar(100)
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  student Student  @relation(fields: [studentId], references: [id])
  branch  Branch   @relation(fields: [branchId], references: [id])
  receipt Receipt?

  @@index([studentId, status])
  @@index([branchId, createdAt])
  @@map("payment_transactions")
}

model Receipt {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String   @unique @map("transaction_id") @db.Uuid
  receiptNumber String   @unique @map("receipt_number") @db.VarChar(50)
  documentUrl   String?  @map("document_url") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  transaction PaymentTransaction @relation(fields: [transactionId], references: [id])

  @@index([receiptNumber])
  @@map("receipts")
}

// ─── Phase 8: Timetable Scheduling & Conflict Engine ──────────────────────────

model Room {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(100)
  capacity   Int
  branchId   String   @map("branch_id") @db.Uuid
  isArchived Boolean  @default(false) @map("is_archived")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  branch            Branch             @relation(fields: [branchId], references: [id])
  timetableSessions TimetableSession[]

  @@index([branchId, isArchived])
  @@map("rooms")
}

model TimetableSession {
  id        String    @id @default(uuid()) @db.Uuid
  batchId   String    @map("batch_id") @db.Uuid
  teacherId String    @map("teacher_id") @db.Uuid
  roomId    String    @map("room_id") @db.Uuid
  branchId  String    @map("branch_id") @db.Uuid
  dayOfWeek DayOfWeek @map("day_of_week")
  startTime String    @map("start_time") @db.VarChar(5) // Format: HH:mm
  endTime   String    @map("end_time") @db.VarChar(5) // Format: HH:mm
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  batch   Batch          @relation(fields: [batchId], references: [id])
  teacher TeacherProfile @relation(fields: [teacherId], references: [id])
  room    Room           @relation(fields: [roomId], references: [id])
  branch  Branch @relation(fields: [branchId], references: [id])

  @@index([branchId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
  @@index([roomId, dayOfWeek])
  @@index([batchId, dayOfWeek])
  @@map("timetable_sessions")
}

// ─── Phase 11: Notifications & Messaging ──────────────────────────────────────

model Notification {
  id            String                    @id @default(uuid()) @db.Uuid
  recipientId   String                    @map("recipient_id") @db.Uuid // Can be User, Student, or Guardian
  recipientType NotificationRecipientType @map("recipient_type")
  channel       NotificationChannel
  title         String                    @db.VarChar(255)
  body          String                    @db.Text
  status        NotificationStatus        @default(QUEUED)
  metadata      Json?                     @db.JsonB
  branchId      String                    @map("branch_id") @db.Uuid
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId, status])
  @@index([recipientId, createdAt])
  @@map("notifications")
}

model NotificationTemplate {
  id           String              @id @default(uuid()) @db.Uuid
  code         String              @db.VarChar(100) // e.g. FEE_DUE_REMINDER
  channel      NotificationChannel
  subject      String?             @db.VarChar(255) // Relevant for Email
  bodyTemplate String              @map("body_template") @db.Text // Contains mustache tags like {{student_name}}
  branchId     String              @map("branch_id") @db.Uuid
  isArchived   Boolean             @default(false) @map("is_archived")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId, code, channel])
  @@map("notification_templates")
}

// ─── Phase 14: HR & Payroll ───────────────────────────────────────────────────

model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  branchId  String   @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  branch          Branch           @relation(fields: [branchId], references: [id])
  teacherSubjects TeacherSubject[]

  @@unique([branchId, name])
  @@index([branchId])
  @@map("subjects")
}

model TeacherProfile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @unique @map("user_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  name           String   @db.VarChar(150)
  phone          String?  @db.VarChar(20)
  address        String?  @db.Text
  specialization String?  @db.VarChar(150)
  qualification  String?  @db.VarChar(255)
  joiningDate    DateTime @map("joining_date") @db.Date
  baseSalary     Int      @default(0) @map("base_salary") // stored in paise/cents
  hourlyRate     Int      @default(0) @map("hourly_rate") // stored in paise/cents
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch          Branch           @relation(fields: [branchId], references: [id])
  teacherSubjects TeacherSubject[]
  payrollRecords  PayrollRecord[]
  timetableSessions TimetableSession[]
  examsInvigilated  Exam[] @relation("ExamInvigilator")

  @@index([branchId])
  @@map("teacher_profiles")
}

model TeacherSubject {
  teacherId String @map("teacher_id") @db.Uuid
  subjectId String @map("subject_id") @db.Uuid

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
  @@index([teacherId])
  @@index([subjectId])
  @@map("teacher_subjects")
}

model PayrollRecord {
  id          String        @id @default(uuid()) @db.Uuid
  teacherId   String        @map("teacher_id") @db.Uuid
  branchId    String        @map("branch_id") @db.Uuid
  month       Int           @db.SmallInt
  year        Int           @db.SmallInt
  amountPaid  Int           @map("amount_paid") // stored in paise/cents
  bonus       Int           @default(0) // stored in paise/cents
  deductions  Int           @default(0) // stored in paise/cents
  status      PayrollStatus @default(PENDING)
  paymentDate DateTime?     @map("payment_date") @db.Timestamptz
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  branch  Branch         @relation(fields: [branchId], references: [id])

  @@unique([teacherId, month, year])
  @@index([branchId, month, year])
  @@index([teacherId])
  @@map("payroll_records")
}

// ─── Phase 15: Inventory Management ───────────────────────────────────────────

model InventoryItem {
  id                String            @id @default(uuid()) @db.Uuid
  name              String            @db.VarChar(255)
  category          InventoryCategory
  sku               String            @db.VarChar(50)
  stockQuantity     Int               @default(0) @map("stock_quantity")
  minStockThreshold Int               @default(10) @map("min_stock_threshold")
  price             Int               @default(0) // stored in paise/cents
  branchId          String            @map("branch_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  branch            Branch             @relation(fields: [branchId], references: [id])
  stockTransactions StockTransaction[]
  materialIssues    MaterialIssue[]

  @@unique([branchId, sku])
  @@index([branchId])
  @@map("inventory_items")
}

model StockTransaction {
  id        String               @id @default(uuid()) @db.Uuid
  itemId    String               @map("item_id") @db.Uuid
  branchId  String               @map("branch_id") @db.Uuid
  type      StockTransactionType
  quantity  Int
  remarks   String?              @db.Text
  date      DateTime             @default(now()) @db.Timestamptz
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz

  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  branch Branch        @relation(fields: [branchId], references: [id])

  @@index([itemId])
  @@index([branchId])
  @@map("stock_transactions")
}

model MaterialIssue {
  id         String   @id @default(uuid()) @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  quantity   Int
  issuedById String   @map("issued_by_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  date       DateTime @default(now()) @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  student  Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  issuedBy User          @relation("Issuer", fields: [issuedById], references: [id])
  branch   Branch        @relation(fields: [branchId], references: [id])

  @@index([studentId])
  @@index([itemId])
  @@index([branchId])
  @@map("material_issues")
}

// ─── Phase 16: Maintenance & Expenses ──────────────────────────────────────────

model MaintenanceExpense {
  id          String          @id @default(uuid()) @db.Uuid
  branchId    String          @map("branch_id") @db.Uuid
  title       String          @db.VarChar(200)
  category    ExpenseCategory
  amount      Int             // Stored in paise/cents
  paymentMode PaymentMethod   @map("payment_mode")
  status      ExpenseStatus   @default(PENDING)
  explanation String?         @db.Text
  resolvedAt  DateTime?       @map("resolved_at") @db.Timestamptz
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  branch      Branch          @relation(fields: [branchId], references: [id])

  @@index([branchId, status])
  @@index([branchId, createdAt])
  @@map("maintenance_expenses")
}
